# Phase 12 SHA-256 绑定按文件字节计算，强制 LF 保证跨平台可复核。
benchmark/instance_quality_v1/**/*.json text eol=lf
benchmark/instance_quality_v1/**/*.jsonl text eol=lf
benchmark/instance_quality_v1/**/*.md text eol=lf
benchmark/instance_quality_v1/**/*.py text eol=lf

# LOCAL_VLM_QUALITY_COMPARISON_V1 证据图片保留原始字节，仅二进制证据走 Git LFS。
evidence/**/original.* filter=lfs diff=lfs merge=lfs -text
evidence/**/local_output.* filter=lfs diff=lfs merge=lfs -text
evidence/**/cloud_output.* filter=lfs diff=lfs merge=lfs -text

# 人工评分源、私有映射和冻结合同必须保持原始字节，不做换行规范化。
evidence/blinded_scores.json -text -diff -merge
evidence/private_blinding_map.json -text -diff -merge
evidence/FROZEN_CONTRACT.md -text -diff -merge

# 机械生成的审查视图与报告使用稳定 LF，仍由普通 Git 管理。
evidence/manifest.json text eol=lf
evidence/EVIDENCE_REPORT.md text eol=lf
evidence/**/evaluation.json text eol=lf
evidence/**/requirement.md text eol=lf

# GENERAL_RGB_FINAL_ACCEPTANCE_V1 的执行图片、mask、审查页与冻结输入保留原始字节并走 Git LFS。
evidence/final_acceptance/**/artifacts/**/*.jpg filter=lfs diff=lfs merge=lfs -text
evidence/final_acceptance/**/artifacts/**/*.png filter=lfs diff=lfs merge=lfs -text
evidence/final_acceptance/**/review_sheets/*.jpg filter=lfs diff=lfs merge=lfs -text
evidence/final_acceptance/**/inputs/by_sha256/* filter=lfs diff=lfs merge=lfs -text

# R3 candidate identity 冻结执行生成的 PNG evidence 与 SAM mask 保留原始字节并走 Git LFS。
evidence/final_acceptance/GENERAL_RGB_R3_CANDIDATE_IDENTITY_REMEDIATION_V1/execution/evidence/**/*.png filter=lfs diff=lfs merge=lfs -text
evidence/final_acceptance/GENERAL_RGB_R3_CANDIDATE_IDENTITY_REMEDIATION_V1/execution/mask_cache/**/*.bin filter=lfs diff=lfs merge=lfs -text

# Behavior long-range context 只读归因材料使用稳定 LF，便于逐字节审计。
evidence/final_acceptance/GENERAL_RGB_BEHAVIOR_LONG_RANGE_CONTEXT_REMEDIATION_V1/*.md text eol=lf
evidence/final_acceptance/GENERAL_RGB_BEHAVIOR_LONG_RANGE_CONTEXT_REMEDIATION_V1/*.json text eol=lf

# Behavior Production Policy Synthesis 只读材料使用稳定 LF。
evidence/final_acceptance/GENERAL_RGB_BEHAVIOR_POLICY_SYNTHESIS_V1/*.md text eol=lf
evidence/final_acceptance/GENERAL_RGB_BEHAVIOR_POLICY_SYNTHESIS_V1/*.json text eol=lf

# Behavior uncertain routing 只读机械模拟材料使用稳定 LF。
evidence/final_acceptance/GENERAL_RGB_BEHAVIOR_UNCERTAIN_ROUTING_SYNTHESIS_V1/*.md text eol=lf
evidence/final_acceptance/GENERAL_RGB_BEHAVIOR_UNCERTAIN_ROUTING_SYNTHESIS_V1/*.json text eol=lf
